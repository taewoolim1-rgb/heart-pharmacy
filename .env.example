# Supabase project settings (Project Settings > API in the Supabase dashboard).
# Required in production (Vercel project > Settings > Environment Variables).
# SUPABASE_SERVICE_ROLE_KEY must stay server-side only — never expose it to
# the browser bundle (do not prefix it with VITE_).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Passcode required to write/edit/delete notices on the 소식 및 공지사항 board.
# Optional — defaults to 73103110 (the value baked into the admin login modal)
# when unset. Set this to change the passcode without a code change.
ADMIN_PASSCODE=
